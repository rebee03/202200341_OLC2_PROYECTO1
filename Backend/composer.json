{
    "name": "golampi/interpreter",
    "description": "Golampi Interpreter - OLC2",
    "type": "project",
    "require": {
        "antlr/antlr4-php-runtime": "^0.9.1"
    },
    "autoload": {
        "psr-4": {
            "": "src/"
        },
        "files": [
